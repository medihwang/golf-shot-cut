{
  "name": "골프 샷 자동 컷",
  "short_name": "샷 컷",
  "description": "샷마다 찍은 골프 영상에서 샷 부분만 잘라 이어 붙입니다. 영상은 휴대폰 밖으로 나가지 않아요.",
  "lang": "ko",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5f6f2",
  "theme_color": "#2e7d32",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "videos", "accept": ["video/*", ".mp4", ".mov"] }]
    }
  }
}
